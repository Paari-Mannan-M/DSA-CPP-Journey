
#include <iostream>
using namespace std;

#define SIZE 5

int dq[SIZE];
int front = -1, rear = -1;

void insertFront(int x) {
    if (front == 0) {
        cout << "Cannot insert at front\n";
        return;
    }
    if (front == -1)
        front = rear = 0;
    else
        front--;

    dq[front] = x;
}

void insertRear(int x) {
    if (rear == SIZE - 1) {
        cout << "Queue Overflow\n";
        return;
    }
    if (front == -1)
        front = rear = 0;
    else
        rear++;

    dq[rear] = x;
}

void deleteFront() {
    if (front == -1) {
        cout << "Queue Underflow\n";
        return;
    }
    cout << "Deleted: " << dq[front] << endl;

    if (front == rear)
        front = rear = -1;
    else
        front++;
}

void deleteRear() {
    if (rear == -1) {
        cout << "Queue Underflow\n";
        return;
    }
    cout << "Deleted: " << dq[rear] << endl;

    if (front == rear)
        front = rear = -1;
    else
        rear--;
}

void display() {
    if (front == -1) {
        cout << "Queue is empty\n";
        return;
    }
    for (int i = front; i <= rear; i++)
        cout << dq[i] << " ";
    cout << endl;
}

int main() {
    insertRear(10);
    insertRear(20);
    insertFront(5);
    display();

    deleteFront();
    deleteRear();
    display();

    return 0;
}
