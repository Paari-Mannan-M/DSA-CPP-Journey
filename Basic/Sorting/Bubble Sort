#include <iostream>
using namespace std;

void bubbleSort(int A[], int n)
{
    for(int j = 0; j < n; j++)
    {
        for(int i = 0; i < n - 1 - j; i++)
        {
            if(A[i] > A[i + 1])
            {
                int temp = A[i];
                A[i] = A[i + 1];
                A[i + 1] = temp;
            }
        }
    }
}

int main()
{
    int A[] = {5, 3, 8, 4, 2};
    int n = 5;
    bubbleSort(A, n);
    cout << "Sorted array: ";

    for(int i = 0; i < n; i++)
    {
        cout << A[i] << " ";
    }
    return 0;
}
