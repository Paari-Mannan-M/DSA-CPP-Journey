#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

void insertBeginning(Node* head, int val) {
    Node* newNode = new Node;
    newNode->data = val;

    if (head->next == head) {
        newNode->next = head;
        head->next = newNode;
    }
    else {
        newNode->next = head->next;
        head->next = newNode;
    }
}

int main() {
    Node* head = new Node;
    head->next = head;

    insertBeginning(head, 10);
    insertBeginning(head, 20);
    insertBeginning(head, 30);

    Node* temp = head->next;

    while (temp != head) {
        cout << temp->data << " ";
        temp = temp->next;
    }
}
