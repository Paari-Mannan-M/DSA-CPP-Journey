#include <iostream>
using namespace std;

struct Node {
    char data;
    Node* next;
};

void deleteEnd(Node*& head) {
    if (head->next == head) {
        cout << "List is empty";
        return;
    }

    Node* temp = head->next;

    while (temp->next->next != head)
        temp = temp->next;

    Node* last = temp->next;
    temp->next = head;
    delete last;
}

int main() {
    Node* head = new Node;
    head->next = head;

    Node* a = new Node{'A', head};
    Node* b = new Node{'B', head};
    Node* c = new Node{'C', head};

    head->next = a;
    a->next = b;
    b->next = c;

    deleteEnd(head);
}
