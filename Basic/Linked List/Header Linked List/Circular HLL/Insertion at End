#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

void insertEnd(Node* head, int val) {
    Node* newNode = new Node;
    newNode->data = val;

    Node* temp = head;

    while (temp->next != head) {
        temp = temp->next;
    }

    newNode->next = head;
    temp->next = newNode;
}

int main() {
    Node* head = new Node;
    head->next = head;

    insertEnd(head, 10);
    insertEnd(head, 20);
    insertEnd(head, 30);

    Node* temp = head->next;

    while (temp != head) {
        cout << temp->data << " ";
        temp = temp->next;
    }
}
