#include <iostream>
using namespace std;

struct Node
{
    char data;
    Node* next;
};

void deleteEnd(Node*& head, char val)
{
    if (head == NULL)
    {
        cout << "List is empty";
    }
    else if (head->next == NULL)
    {
        val = head->data;
        delete head;
        head = NULL;
    }
    else
    {
        Node* temp = head;

        while (temp->next->next != NULL)
        {
            temp = temp->next;
        }

        val = temp->next->data;
        delete temp->next;
        temp->next = NULL;
    }
}

void display(Node* head)
{
    Node* temp = head;

    while (temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->next;
    }
}

int main()
{
    Node* head = new Node{'A', NULL};
    head->next = new Node{'B', NULL};
    head->next->next = new Node{'C', NULL};

    cout << "Before deletion: ";
    display(head);

    char val;
    deleteEnd(head, val);

    cout << "\nDeleted value: " << val;

    cout << "\nAfter deletion: ";
    display(head);
}
