#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;
};

void deleteAtBeginning(Node*& head)
{
    if (head == NULL)
    {
        cout << "List is empty";
    }
    else if (head->next == head)
    {
        delete head;
        head = NULL;
    }
    else
    {
        Node* temp = head;

        while (temp->next != head)
        {
            temp = temp->next;
        }

        Node* del = head;
        head = head->next;
        temp->next = head;

        delete del;
    }
}

void display(Node* head)
{
    if (head == NULL)
    {
        cout << "List is empty";
    }
    else
    {
        Node* temp = head;

        do
        {
            cout << temp->data << " ";
            temp = temp->next;
        }
        while (temp != head);
    }
}

int main()
{
    Node* head = NULL;

    // Creating nodes
    Node* a = new Node{10, NULL};
    Node* b = new Node{20, NULL};
    Node* c = new Node{30, NULL};

    head = a;
    a->next = b;
    b->next = c;
    c->next = head;

    cout << "Before deletion: ";
    display(head);

    deleteAtBeginning(head);

    cout << "\nAfter deletion: ";
    display(head);

    return 0;

}
