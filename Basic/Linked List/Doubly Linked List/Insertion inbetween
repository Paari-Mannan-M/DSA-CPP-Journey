#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* prev;
    Node* next;
};

void insertBetween(Node*& head, int val)
{
    Node* temp = head;

    while (temp->data != 20)
        temp = temp->next;

    Node* newNode = new Node;
    newNode->data = val;

    newNode->next = temp->next;
    newNode->prev = temp;

    temp->next->prev = newNode;
    temp->next = newNode;
}

void display(Node* head)
{
    while (head != NULL)
    {
        cout << head->data << " ";
        head = head->next;
    }
}

int main()
{
    Node* head = new Node{10, NULL, NULL};
    Node* second = new Node{20, head, NULL};
    Node* third = new Node{40, second, NULL};

    head->next = second;
    second->next = third;

    insertBetween(head, 30);

    display(head);
}
