#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* prev;
    Node* next;
};

void deleteBeginning(Node*& head) {
    if (head == NULL) {
        cout << "List is empty";
    }
    else {
        Node* temp = head;
        head = head->next;

        if (head != NULL) {
            head->prev = NULL;
        }

        delete temp;
    }
}

int main() {
    Node* head = new Node{10, NULL, NULL};
    Node* second = new Node{20, head, NULL};
    Node* third = new Node{30, second, NULL};

    head->next = second;
    second->next = third;

    deleteBeginning(head);

    Node* temp = head;
    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }
}
