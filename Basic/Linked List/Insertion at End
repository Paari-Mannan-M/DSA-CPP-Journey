#include <iostream>
using namespace std;

struct Node
{
    char data;
    Node* next;
};

void insertEnd(Node*& head, char val)
{
    Node* newNode = new Node;
    newNode->data = val;
    newNode->next = NULL;

    if (head == NULL)
    {
        head = newNode;
    }
    else
    {
        Node* temp = head;
        while (temp->next != NULL)
        {
            temp = temp->next;
        }
        temp->next = newNode;
    }
}

void display(Node* head)
{
    Node* temp = head;
    while (temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->next;
    }
}

int main() {
    Node* head = NULL;

    insertEnd(head, 'A');
    insertEnd(head, 'B');
    insertEnd(head, 'C');

    display(head);
}
