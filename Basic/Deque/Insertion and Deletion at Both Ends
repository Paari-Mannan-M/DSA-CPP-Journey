#include <iostream>
#include <deque>
using namespace std;

int main() {
    deque<int> dq;

    dq.push_back(10);
    dq.push_back(20);
    dq.push_front(5);

    cout << "Deque: ";
    for (int x : dq)
        cout << x << " ";

    cout << "\nDelete Front: ";
    dq.pop_front();

    cout << "\nDelete Rear: ";
    dq.pop_back();

    cout << "\nRemaining: ";
    for (int x : dq)
        cout << x << " ";

    return 0;
}
