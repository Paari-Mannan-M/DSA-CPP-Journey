#include <iostream>
using namespace std;

int main() {
    int size;

    cin>>size;

    int arr[size];
    
    for(int i=0; i<size; i++)
       cin>>arr[i];
       
        //Find the Largest Element of the Array
    int large = 0;

    for(int i=1; i<size; i++){
       if(arr[i] > arr[large]){
          large = i;
        }
    }
          
    cout<<"Largest element is: " << arr[large];
    
    return 0;
}
