#include <iostream>
using namespace std;

int main() {
    int size;
    cin >> size;       // Size of array

    int arr[100];

    int n;             // Current number of elements
    cin >> n;

    for (int i = 0; i < n; i++)
        cin >> arr[i];

    int item, index;

    // Insert item at given index
    cin >> item;
    cin >> index;

    // Shift elements to the right
    for (int i = n - 1; i >= index; i--)
        arr[i + 1] = arr[i];

    // Insert the item
    arr[index] = item;
    n++;

    // Print array
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    return 0;
}
