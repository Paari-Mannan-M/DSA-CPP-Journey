#include <iostream>
using namespace std;

int sum(int x,int y,int z=0,int w=0) {  //default values are given to variable in the right side

return(x+y+z+w);

}

int main() {
	cout<<sum(10,15)<<endl;//default arguments reads from left to right 
	cout<<sum(10,15,20)<<endl;
	cout<<sum(10,15,20,15)<<endl;
}
