#include<iostream>
using namespace std;

int main() {
	int *n = NULL;
	n = new int;
	cin>>*n;
	
	int *arr = NULL;
	arr= new int[*n];
	for(int i=0;i<*n;i++){
		cin>>arr[i];
	}
	int sum = 0;
	cout<<"Elements are:"<<endl;
	for(int i=0;i<*n;i++){
		cout<<arr[i]<<" ";
		sum = sum + arr[i];
	}
	cout<<"\nSum of elements:"<<sum;
	
	
	delete[] arr;
	delete n;
	
	return 0;
}
